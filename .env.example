# MyFundedPerps API configuration. Never put real credentials in this file.
MFP_BASE_URL=https://developers.myfundedperpetuals.com
MFP_API_KEY=fp_live_REPLACE_WITH_YOUR_API_KEY

# Exact competition account ID used by auto_sl.py.
AUTO_SL_ACCOUNT_ID=REPLACE_WITH_YOUR_ACCOUNT_ID

# Optional alert destination. Leave blank to disable Discord notifications.
DISCORD_WEBHOOK_URL=

# Initial stop distance and active review interval.
SL_PERCENT=1
CHECK_INTERVAL=30

# Break-even and trailing-stop thresholds, measured in R.
BREAKEVEN_R=1
TRAILING_ACTIVATION_R=2
TRAILING_DISTANCE_R=1

# Safety locks: leave disabled unless you deliberately reviewed live execution.
DRY_RUN=true
AUTO_SL_EXECUTE=false
AUTO_SL_UNATTENDED=false
